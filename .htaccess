# Position Xero — Apache config (Hostinger)

# Serve the branded 404 page with a real 404 status (avoids soft-404s).
ErrorDocument 404 /404.html

# Redirect direct /index.html (and /blog/index.html) hits to the clean canonical URL.
# THE_REQUEST condition prevents loops when Apache serves "/" via DirectoryIndex internally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# OPTIONAL — canonical host + HTTPS enforcement.
# The canonical domain is https://www.positionxero.com (matches <link rel="canonical">
# and the sitemap). Uncomment ONLY after confirming the domain serves both the
# www and non-www / http variants, or you may cause a redirect loop.
# ---------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   # Force HTTPS
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://www.positionxero.com%{REQUEST_URI} [L,R=301]
#   # Force www
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.positionxero.com%{REQUEST_URI} [L,R=301]
# </IfModule>

# Long-cache static assets for performance (safe for hashed/owned assets).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Long-cache web fonts and icon images as immutable (no revalidation).
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|jpg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compress text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain font/woff2 font/woff application/font-woff2 text/markdown application/manifest+json
</IfModule>

# Security / response headers (safe, code-only — no rendering changes).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
